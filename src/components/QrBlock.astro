---
import fs from 'node:fs';
import path from 'node:path';
import { site, whatsappUrl } from '../config';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
  /** compact = footer; card = share/book/contact/home */
  variant?: 'compact' | 'card';
}

const { dict, variant = 'compact' } = Astro.props;
const isCard = variant === 'card';

const shareMessage = dict.share.message;
const waShareHref = `https://wa.me/?text=${encodeURIComponent(shareMessage)}`;
const emailShareHref = `mailto:?subject=${encodeURIComponent(dict.share.emailSubject)}&body=${encodeURIComponent(shareMessage)}`;
const waBookHref = whatsappUrl(dict.share.whatsappQrPrefill);

const publicDir = path.join(process.cwd(), 'public');
const hasWhatsappQr =
  Boolean(site.whatsapp) &&
  (fs.existsSync(path.join(publicDir, 'qr-whatsapp.svg')) ||
    fs.existsSync(path.join(publicDir, 'qr-whatsapp.png')));

const waQrSrc = fs.existsSync(path.join(publicDir, 'qr-whatsapp.svg'))
  ? site.qrWhatsappImage
  : site.qrWhatsappPng;
---

{
  isCard ? (
    <div class="qr-duo">
      {
        hasWhatsappQr && waBookHref ? (
          <aside class="qr-card qr-card-whatsapp" aria-label="WhatsApp booking QR">
            <div class="qr-card-badge">
              <svg class="wa-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <circle cx="12" cy="12" r="12" fill="#25D366"></circle>
                <path
                  fill="#fff"
                  d="M17.5 14.4c-.3-.1-1.6-.8-1.8-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2.1-1.3-.8-.7-1.3-1.6-1.5-1.8-.1-.2 0-.4.1-.5l.4-.5c.1-.1.2-.3.3-.4.1-.2.1-.3 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.8 4.4 3.8 1.6.6 2.2.7 3 .6.5-.1 1.6-.6 1.8-1.3.2-.6.2-1.2.1-1.3-.1-.1-.3-.2-.6-.3z"
                ></path>
              </svg>
              <h2>{dict.share.bookQrTitle}</h2>
            </div>
            <p class="qr-card-lead">{dict.share.bookQrLead}</p>
            <a class="qr-scan-target" href={waBookHref} target="_blank" rel="noopener noreferrer">
              <img
                class="qr-image"
                src={waQrSrc}
                alt={dict.share.bookQrAlt}
                width="512"
                height="512"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="hero-actions share-actions" style="justify-content:center;margin:0">
              <a class="btn btn-whatsapp" href={waBookHref} target="_blank" rel="noopener noreferrer">
                {dict.book.whatsappCta}
              </a>
              <a class="btn btn-ghost" href={site.qrWhatsappPng} download="findmynakshatra-whatsapp-qr.png">
                {dict.share.downloadWa}
              </a>
            </div>
            <p class="note" style="margin:0">{dict.share.bookQrTip}</p>
          </aside>
        ) : null
      }

      <aside class="qr-card" aria-label="Website QR code">
        <h2 style="font-size:1.15rem;margin:0">{dict.share.websiteQrTitle}</h2>
        <p class="qr-card-lead">{dict.share.websiteQrLead}</p>
        <img
          class="qr-image"
          src={site.qrImage}
          alt={`QR code — ${site.domain}`}
          width="512"
          height="512"
          loading="lazy"
          decoding="async"
        />
        <div>
          <p class="label" style="margin:0 0 0.35rem;font-weight:700;color:var(--yellow-deep)">
            {dict.share.linkLabel}
          </p>
          <a href={site.domain} target="_blank" rel="noopener noreferrer">
            {site.domain.replace('https://', '')}
          </a>
        </div>
        <div class="hero-actions share-actions" style="justify-content:center;margin:0">
          <a
            class="btn btn-whatsapp"
            href={waShareHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            {dict.share.whatsappShare}
          </a>
          <a class="btn btn-primary" href={emailShareHref}>
            {dict.share.emailShare}
          </a>
          <a class="btn btn-ghost" href={site.qrImage} download="findmynakshatra-website-qr.png">
            {dict.share.downloadSite}
          </a>
        </div>
        <p class="note" style="margin:0">{dict.share.tip}</p>
      </aside>
    </div>
  ) : (
    <div class="qr-compact" aria-label="QR code">
      {
        hasWhatsappQr && waBookHref ? (
          <a href={waBookHref} class="qr-compact-link qr-compact-wa" target="_blank" rel="noopener noreferrer">
            <span class="qr-compact-thumb">
              <img src={waQrSrc} alt="" width="88" height="88" loading="lazy" decoding="async" />
              <span class="qr-compact-wa-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16">
                  <circle cx="12" cy="12" r="12" fill="#25D366"></circle>
                  <path
                    fill="#fff"
                    d="M17.5 14.4c-.3-.1-1.6-.8-1.8-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2.1-1.3-.8-.7-1.3-1.6-1.5-1.8-.1-.2 0-.4.1-.5l.4-.5c.1-.1.2-.3.3-.4.1-.2.1-.3 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.8 4.4 3.8 1.6.6 2.2.7 3 .6.5-.1 1.6-.6 1.8-1.3.2-.6.2-1.2.1-1.3-.1-.1-.3-.2-.6-.3z"
                  ></path>
                </svg>
              </span>
            </span>
            <span>
              <strong>{dict.share.bookQrTitle}</strong>
              <small>{dict.share.bookQrCompact}</small>
            </span>
          </a>
        ) : (
          <a href={dict.paths.share} class="qr-compact-link">
            <img
              src={site.qrImage}
              alt={`QR — ${site.name}`}
              width="88"
              height="88"
              loading="lazy"
              decoding="async"
            />
            <span>
              <strong>{dict.footer.share}</strong>
              <small>{site.domain.replace('https://', '')}</small>
            </span>
          </a>
        )
      }
    </div>
  )
}
