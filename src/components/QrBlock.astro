---
import { site } from '../config';
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
  /** compact = footer/all pages; card = contact/book/share */
  variant?: 'compact' | 'card';
}

const { dict, variant = 'compact' } = Astro.props;
const isCard = variant === 'card';

const shareMessage = dict.share.message;
const waShareHref = `https://wa.me/?text=${encodeURIComponent(shareMessage)}`;
const emailShareHref = `mailto:?subject=${encodeURIComponent(dict.share.emailSubject)}&body=${encodeURIComponent(shareMessage)}`;
---

{
  isCard ? (
    <aside class="qr-card" aria-label="QR code">
      <h2 style="font-size:1.15rem;margin:0">{dict.footer.share}</h2>
      <img
        class="qr-image"
        src={site.qrImage}
        alt={`QR code — ${site.domain}`}
        width="512"
        height="512"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="label" style="margin:0 0 0.35rem;font-weight:700;color:var(--yellow-deep)">
          {dict.share.linkLabel}
        </p>
        <a href={site.domain} target="_blank" rel="noopener noreferrer">
          {site.domain.replace('https://', '')}
        </a>
      </div>
      <div class="hero-actions share-actions" style="justify-content:center;margin:0">
        <a
          class="btn btn-whatsapp"
          href={waShareHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          {dict.share.whatsappShare}
        </a>
        <a class="btn btn-primary" href={emailShareHref}>
          {dict.share.emailShare}
        </a>
        <a class="btn btn-ghost" href={site.qrImage} download="findmynakshatra-qr.png">
          {dict.share.download}
        </a>
      </div>
      <p class="note" style="margin:0">{dict.share.tip}</p>
    </aside>
  ) : (
    <div class="qr-compact" aria-label="QR code">
      <a href={dict.paths.share} class="qr-compact-link">
        <img
          src={site.qrImage}
          alt={`QR — ${site.name}`}
          width="88"
          height="88"
          loading="lazy"
          decoding="async"
        />
        <span>
          <strong>{dict.footer.share}</strong>
          <small>{site.domain.replace('https://', '')}</small>
        </span>
      </a>
    </div>
  )
}
