# Copy to `.env` for local preview (never commit `.env`)
# Digits only, with country code — example: 91XXXXXXXXXX
PUBLIC_WHATSAPP=

# Optional: only used if you set showPhonePublicly: true in config.ts
# Example: +91 XXXXX XXXXX
PUBLIC_PHONE_DISPLAY=

# Google Analytics 4 Measurement ID — example: G-XXXXXXXXXX
# Also set this in Vercel → Settings → Environment Variables
PUBLIC_GA_MEASUREMENT_ID=
